# mindvirus-defense kit — 층 ② 상주 (systemd user unit)  [예시]
#
# 설치:
#   mkdir -p ~/.config/systemd/user ~/.canon/log
#   sed -e "s|__KIT_ROOT__|$HOME/mindvirus-defense|g" canon-sentinel.service \
#       > ~/.config/systemd/user/canon-sentinel.service
#   cp canon-sentinel.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now canon-sentinel.timer
# 검증:
#   systemctl --user list-timers | grep canon
#   journalctl --user -u canon-sentinel -n 20

[Unit]
Description=canon integrity sentinel (mindvirus-defense layer 2)

[Service]
Type=oneshot
# ★PATH 를 명시한다 — python3 를 못 찾으면 sentinel 은 경보 없이 멈춘다(docs/LIMITS.md §8).
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=CANON_HOME=%h/.canon
ExecStart=/bin/bash __KIT_ROOT__/scripts/canon-sentinel.sh
