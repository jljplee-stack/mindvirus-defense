# canon.env — 사이트 설정 [예시]. 스케줄러·셸에서 source 해서 쓴다.
# mindvirus-defense kit · MIT
#
#   set -a; . ~/.canon/canon.env; set +a
#
# ※ 전부 선택이다. 아무것도 설정하지 않아도 ~/.canon 기준 기본값으로 동작한다.

# ── 경로 ────────────────────────────────────────────────────────────
export CANON_HOME="$HOME/.canon"                 # 상태(인벤토리·베이스라인·원장·경보상태) 루트
# export CANON_INVENTORY="$CANON_HOME/inventory.conf"
# export CANON_BASELINE="$CANON_HOME/baseline.tsv"
# export CANON_LEDGER="$CANON_HOME/resign-ledger.jsonl"
# export CANON_ALERT_STATE="$CANON_HOME/alert-state.tsv"
# export CANON_PROTECTED="$CANON_HOME/protected.conf"    # 층 ③ 보호 경로 목록
# export CANON_BIN="$HOME/mindvirus-defense/scripts"     # 보통 스크립트가 스스로 찾는다

# ── 경보 채널(플러거블) ─────────────────────────────────────────────
# 비워 두면 $CANON_ALERT_LOG 파일에 append 한다(설정 0으로도 돈다).
# 지정하면 그 명령을 실행하고 **경보 본문을 stdin 으로** 넘긴다.
#   그 명령이 받는 환경변수: CANON_ALERT_LEVEL(ALERT|NOTICE|BROKEN) · CANON_ALERT_FROM
# export CANON_ALERT_CMD="$HOME/mindvirus-defense/examples/alert-cmds/alert-slack.sh"
# export CANON_ALERT_CMD="$HOME/mindvirus-defense/examples/alert-cmds/alert-mail.sh"
# export CANON_ALERT_CMD="my-fleet notify --to orchestrator"
export CANON_ALERT_LOG="$CANON_HOME/alerts.log"
export CANON_FROM="canon@sentinel"

# Slack 예시 스크립트가 읽는 값
# export CANON_SLACK_WEBHOOK="https://hooks.slack.com/services/XXX/YYY/ZZZ"
# 메일 예시 스크립트가 읽는 값
# export CANON_MAIL_TO="ops@example.com"

# ── 행위자 게이트(층 ②의 재서명 권한) ────────────────────────────────
# 재서명은 오케스트레이터 권한이다. 현재 행위자의 역할을 어떻게 알아내는지는
# 조직마다 다르므로 플러그인으로 둔다. 아래 둘 중 하나만 있으면 된다.
# export CANON_ROLE="worker-3"                       # 역할을 직접 주입(에이전트 기동 시)
# export CANON_ROLE_CMD="my-fleet whoami --role"     # 역할명을 한 줄로 출력하는 아무 명령
# export CANON_DENY_ROLES="worker* reviewer* planner* agent* sub-*"   # 거부 대상(공백 구분 glob)
#
# ⚠ 역할이 미상이면 통과한다(사람이 직접 치는 셸까지 막지는 않는다는 정책).
#   이 게이트는 보안 경계가 아니라 **오작동·월권 차단**이다 — docs/LIMITS.md 를 읽어라.
